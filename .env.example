# Ansible Zero-to-Hero / SRE Incident Simulator
# Configuration File

# Port to expose the web portal on the host machine
PORTAL_PORT=8080

# Host interface to bind to. Default 127.0.0.1 (local only). Set to 0.0.0.0 for LAN/Cloud access.
BIND_HOST=127.0.0.1

# Compose Project Name (use unique names for multi-tenant classroom setups, e.g. student01)
COMPOSE_PROJECT_NAME=ansible-lab

# Container image prefix and tag
# Pre-built GHCR images: ghcr.io/your-org/ansible-lab-
# Local builds: ansible-lab-
IMAGE_PREFIX=ansible-lab-
IMAGE_TAG=latest

# Docker socket path on host
DOCKER_SOCKET_PATH=/var/run/docker.sock

# Optional: Docker socket proxy (uncomment if using tecnativa/docker-socket-proxy)
# DOCKER_HOST=tcp://docker-socket-proxy:2375
